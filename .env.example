# ==============================================
# TechBildAcess - Variáveis de ambiente (Vite)
# Copie este arquivo para ".env" e preencha os valores.
# ==============================================

# URL do seu projeto Supabase (Settings > API > Project URL)
VITE_SUPABASE_URL=

# Chave pública (anon / publishable) do Supabase (Settings > API)
VITE_SUPABASE_ANON_KEY=

# local (padrão): salva neste navegador. supabase: ativa o serviço externo.
VITE_STORAGE_MODE=local

# URL pública onde o app roda (usada em redirects e compartilhamento)
VITE_APP_URL=http://localhost:5173

# E-mails autorizados como administradores (separados por vírgula)
VITE_ADMIN_EMAILS=igoraguiarviana@gmail.com,techbilld@gmail.com,igor.vianaaidev@gmail.com
